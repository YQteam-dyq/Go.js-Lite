{
  "name": "go.js-lite",
  "version": "0.7.0",
  "description": "Go.js-Lite - A lightweight JavaScript framework",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/output.css",
    "build:js": "tsc",
    "dev": "concurrently \"npm run dev:css\" \"npm run dev:js\"",
    "dev:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "dev:js": "tsc --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": ["javascript", "framework", "web", "development"],
  "author": "YQteam-dyq",
  "license": "MIT",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.8.0",
    "@tanstack/react-query": "^4.29.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tailwindcss": "^3.3.0",
    "concurrently": "^8.2.0"
  }
}