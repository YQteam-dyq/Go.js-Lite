# Go.js - 轻量级 PHP 服务器管理面板
# Apache 配置文件（可部署于任意子目录 /gojs/、/panel/ 或根目录，无需修改本文件）

# 禁止访问 .gojs 配置目录
<DirectoryMatch "^.*/\.gojs/">
    Order Allow,Deny
    Deny from all
</DirectoryMatch>

<FilesMatch "^\.gojs">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# 禁止访问配置文件
<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>

# 禁止访问 .htaccess
<Files ".htaccess">
    Order Allow,Deny
    Deny from all
</Files>

# 禁止访问 .log 文件
<FilesMatch "\.log$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# 禁止访问 .json 配置文件
<FilesMatch "db_connections\.json$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ====== 入口 ======
# 前端构建产物位于 dist/ 子目录，目录请求（如 /gojs/）直接指向它。
# 若你手动把 dist/ 内容平铺到本目录，请改为：DirectoryIndex index.html
DirectoryIndex dist/index.html index.html

# 开启 URL 重写
RewriteEngine On

# 本文件使用相对路径重写（不写 RewriteBase），自动适配任意挂载点：
# 部署在 /gojs/、/panel/ 或根目录均无需修改任何配置。

# 1) API 路由：/api/xxx -> api.php?api=xxx
RewriteRule ^api/(.*)$ api.php?api=$1 [QSA,L]

# 2) 前端静态资源：/assets/* -> dist/assets/*（仅当根目录不存在同名文件时）
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

# 3) SPA 前端路由：非文件/目录请求统一交给前端 index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !/dist/
RewriteRule ^ dist/index.html [L]

# 安全头部
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# PHP 设置
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value error_log .gojs/php_errors.log
</IfModule>
