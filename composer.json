{
    "name": "gojs-lite/gojs-lite",
    "description": "Go.js-Lite lightweight shared-hosting management panel (backend)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "files": [
            "backend/autoload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Gojs\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}